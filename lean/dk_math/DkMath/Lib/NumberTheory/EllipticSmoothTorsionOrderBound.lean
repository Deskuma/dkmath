import DkMath.Lib.NumberTheory.FiniteFieldWeierstrassCard

#print "file: DkMath.Lib.NumberTheory.EllipticSmoothTorsionOrderBound"

/-!
# NOTE-032: 滑らかな捩れ集合から一元の位数を抑える

`finite_smooth_torsion_ncard_le_two_mul_residue_card_add_one` は、良還元モデルの
滑らかな `n` 捩れ点全体の濃度を評価する。しかし Frey の応用で必要なのは、
一つの点 `Q` の厳密な加法位数の評価である。

ここでは `Q` が `n • Q = 0` を満たすとき、巡回部分群
`AddSubgroup.zmultiples Q` の全ての点が同じ滑らかな `n` 捩れ集合に入ることを示す。
その部分群の濃度は `addOrderOf Q` なので、集合の濃度評価をそのまま個々の点の
位数評価へ輸送できる。

この定理は局所化の具体的なモデルには依存しない。剰余体の有限性と判別式非零性、
および `n` の付値単元性だけを仮定し、後段で `LocalRing q` の剰余体同定を
供給する設計である。
-/

namespace DkMath.Lib.NumberTheory

open WeierstrassCurve IsLocalRing
open EllipticGoodReductionSeparation

noncomputable section

variable {L : Type*} [Field L] [CharZero L]

noncomputable local instance instDecidableEqEllipticSmoothTorsionOrderBound
    {α : Type*} : DecidableEq α := Classical.decEq _

/--
For a good-reduction model, a prime-to-residue-characteristic torsion point
cannot have additive order larger than the elementary residue point-count bound.

The proof has three textbook steps:

1. `finite_smooth_torsion_ncard_le_two_mul_residue_card_add_one` bounds the
   whole smooth `n`-torsion set.
2. The hypothesis `n • Q = 0` makes `Q` a finite-order element, and every
   integer multiple of `Q` remains smooth and `n`-torsion.  Thus the cyclic
   subgroup generated by `Q` is contained in that set.
3. `Nat.card_zmultiples` identifies the cyclic subgroup cardinality with
   `addOrderOf Q`.

No Hasse estimate or classification theorem is used here.
-/
theorem addOrderOf_le_two_mul_residue_card_add_one_of_good
    (A : ValuationSubring L) (W : WeierstrassCurve A)
    [Fintype (IsLocalRing.ResidueField A)]
    (hgood : (W.map (IsLocalRing.residue A)).Δ ≠ 0)
    (Q : (W.map A.subtype).toAffine.Point) {n : ℕ}
    (hn : A.valuation (n : L) = 1) (hQ : n • Q = 0) :
    addOrderOf Q ≤ 2 * Fintype.card (IsLocalRing.ResidueField A) + 1 := by
  classical
  let S : Set (W.map A.subtype).toAffine.Point :=
    {P | HasSmoothReduction W P ∧ n • P = 0}
  have hbound := finite_smooth_torsion_ncard_le_two_mul_residue_card_add_one
    A W hgood hn
  have hsub : (↑(AddSubgroup.zmultiples Q) : Set (W.map A.subtype).toAffine.Point) ⊆ S := by
    intro P hP
    rcases AddSubgroup.mem_zmultiples_iff.mp hP with ⟨k, rfl⟩
    constructor
    · exact hasSmoothReduction_of_good W hgood _
    · rw [smul_comm, hQ, smul_zero]
  have hn0 : n ≠ 0 := by
    intro hn0
    subst n
    simp at hn
  have hfinorder : IsOfFinAddOrder Q :=
    isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨n, Nat.pos_of_ne_zero hn0, hQ⟩
  let : Finite (AddSubgroup.zmultiples Q) := finite_zmultiples.mpr hfinorder
  let H := AddSubgroup.zmultiples Q
  let e : H ≃ (↑H : Set (W.map A.subtype).toAffine.Point) :=
    { toFun := fun x => ⟨x.1, x.2⟩
      invFun := fun x => ⟨x.1, x.2⟩
      left_inv := by intro x; rfl
      right_inv := by intro x; rfl }
  have hcard : addOrderOf Q = Set.ncard (↑H : Set (W.map A.subtype).toAffine.Point) := by
    calc
      addOrderOf Q = Nat.card H := (Nat.card_zmultiples Q).symm
      _ = Nat.card (↑H : Set (W.map A.subtype).toAffine.Point) :=
        (Nat.card_congr e).symm
      _ = Set.ncard (↑H : Set (W.map A.subtype).toAffine.Point) :=
        Nat.card_coe_set_eq _
  rw [hcard]
  calc
    Set.ncard (↑H : Set (W.map A.subtype).toAffine.Point) ≤ S.ncard :=
      Set.ncard_le_ncard hsub hbound.1
    _ ≤ 2 * Fintype.card (IsLocalRing.ResidueField A) + 1 := hbound.2

end
end DkMath.Lib.NumberTheory
