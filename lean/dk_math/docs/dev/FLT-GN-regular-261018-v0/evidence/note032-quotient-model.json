  "mathematics": {
    "reflection": "same normalized X_H fixed; Y_H sent to -Y_H-a1X_H-a3; identity-point correction treated separately",
    "quadratic": "same residual R lies in same F_H and is reflection-fixed; [F_H:k(X_H)]=2 and moved Y_H give R in k(X_H)",
    "denominator": "each finite value of same X_H has a detecting zero outside H; reduced p/q and Bezout exclude a nonconstant denominator of a kernel-outside regular rational expression",
    "pole_bound": "regular corrections X_H-x,Y_H-y and source equation bound R pole by4; X_H pole2 gives residual polynomial degree<=2",
    "model": "actual W over algebraic closure, same a1,a3, monic cubic equation; generic point is nonsingular; no same-a2 claim",
    "coordinate_injection": "arbitrary W and target field; x transcendental and y not in k(x) imply injectivity by p(x)+q(x)y basis",
    "function_pull": "actual fraction-field algebra hom with image k(X_H,Y_H)=F_H; field extension degree |H|",
    "uniqueness": "same coordinates and same a1,a3 give actual equality of Weierstrass models",
    "descent": "stable H gives semilinear invariance of equation; uniqueness gives fixed coefficients; actual K-model basechange equals chosen same model",
    "Source": "same Source, same line, same actual pointSubgroup; degree p internally supplied; stable line yields rational coefficient model"
  },
  "generality": [
    "reflection formulas, denominator elimination and pole estimates work in arbitrary characteristic",
    "model construction, nontrivial reflection and descent implemented for characteristic zero",
    "finite H may have arbitrary order, including trivial and even",
    "stability only required for coefficient descent; no individual rational-kernel-point hypothesis",
    "Source wrappers retain dimension1; rational coefficient descent retains same-line stability; no Source or stable-line existence asserted"
  ],
  "boundary": {
