import DkMath.FLT.FreyCandidateCofixedExclusion

#print "file: DkMathTest.FLT.FreyCandidateCofixedExclusion"

namespace FreyCandidateCofixedTest
abbrev G := ZMod 125 × ZMod 125
private def K : AddSubgroup G := AddSubgroup.zmultiples (5, 0)

-- For the SAME K generated by (5,0), the narrow p-preimage reaches past G[25].
example : 5 • ((1, 0) : G) ∈ K := by
  change ((5, 0) : G) ∈ AddSubgroup.zmultiples (5, 0)
  exact ⟨1, by simp⟩
example : (25 : ℕ) • ((1, 0) : G) ≠ 0 := by decide
example : (25 : ℕ) • ((5, 0) : G) = 0 := by decide

-- Conversely, G[25] has points whose p-multiple is outside the SAME K.
example : (25 : ℕ) • ((0, 5) : G) = 0 := by decide
example : 5 • ((0, 5) : G) ∉ K := by
  intro h
  obtain ⟨k, hk⟩ := h
  have he := congrArg (fun x : G => x.2) hk
  have hz : (0 : ZMod 125) = 5 * 5 := by simpa using he
  exact (by decide : (0 : ZMod 125) ≠ 5 * 5) hz
end FreyCandidateCofixedTest

