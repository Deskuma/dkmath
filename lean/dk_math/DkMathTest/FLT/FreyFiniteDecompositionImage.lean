import DkMath.FLT.FreyFiniteImageResonantLift

#print "file: DkMathTest.FLT.FreyFiniteDecompositionImage"

local instance : Fact (Nat.Prime 5) := ⟨by decide⟩

-- Finite groups need not be generated by the chosen element.
-- Projection to the second coordinate detects the missing generator in the Klein four group.
example (n : ℤ) : n • ((1, 0) : ZMod 2 × ZMod 2) ≠ (0, 1) := by
  intro he
  have hs := congrArg Prod.snd he
  simp at hs

-- Instantiate the finite-field bound on the actual prime field extension of degree1.
example (σ : ZMod 5 ≃ₐ[ZMod 5] ZMod 5) :
    ∃ m : ℕ, m < 1 ∧ FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 5) (ZMod 5) ^ m = σ := by
  simpa only [Module.finrank_self] using
    DkMath.Lib.NumberTheory.FiniteFieldFrobeniusImage.exists_bounded_power (ZMod 5) (ZMod 5) σ

-- Frobenius image generation does not supply the required eigenvalue on the original coefficient.
example : addOrderOf (1 : ZMod 5) = 5 ∧ 2 * (1 : ZMod 5) ≠ 1 ∧ 2 * (1 : ZMod 5) ≠ -1 :=
  ⟨ZMod.addOrderOf_one 5, by decide, by decide⟩

